#!/usr/bin/env bash
set -euo pipefail

config_file="/etc/oci-dicom/stack.json"
export PGHOST="$(jq -r '.postgres_host' "${config_file}")"
export PGPORT="$(jq -r '.postgres_port' "${config_file}")"
export PGDATABASE="$(jq -r '.postgres_database' "${config_file}")"
export PGUSER="$(jq -r '.postgres_username' "${config_file}")"
export PGPASSWORD="$(jq -r '.postgres_password' "${config_file}")"
export PGSSLMODE="require"

exec psql "$@"
