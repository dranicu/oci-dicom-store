#cloud-config
package_update: false
package_upgrade: false
ssh_pwauth: false
disable_root: true

write_files:
  - path: /etc/motd.d/50-oci-dicom
    owner: root:root
    permissions: "0644"
    content: |
      ${deployment_name} OCI DICOM management bastion
      Configuration is managed by Ansible. Run: sudo dicom-status

runcmd:
  - [bash, -lc, "command -v python3 >/dev/null"]
  - [bash, -lc, "touch /var/lib/cloud/instance/ansible-ready"]

final_message: "${deployment_name} bastion cloud-init completed"
