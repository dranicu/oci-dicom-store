apiVersion: v1
kind: Namespace
metadata:
  name: ${namespace}
  labels:
    app.kubernetes.io/part-of: oci-dicom
---
apiVersion: v1
kind: Secret
metadata:
  name: orthanc-runtime
  namespace: ${namespace}
type: Opaque
data:
  orthanc.json: ${orthanc_config_b64}
  postgres-username: ${postgres_username_b64}
  postgres-password: ${postgres_password_b64}
  auth-username: ${orthanc_auth_username_b64}
  auth-password: ${orthanc_auth_password_b64}
  auth-users.json: ${orthanc_auth_users_b64}
  auth-secret: ${orthanc_auth_secret_b64}
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-runtime
  namespace: ${namespace}
type: Opaque
data:
  database-password: ${keycloak_password_b64}
  bootstrap-admin-username: ${keycloak_admin_username_b64}
  bootstrap-admin-password: ${keycloak_admin_password_b64}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: orthanc-authorization
  namespace: ${namespace}
binaryData:
  permissions.json: ${permissions_b64}
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-realm
  namespace: ${namespace}
type: Opaque
data:
  orthanc-realm.json: ${keycloak_realm_b64}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dicom-gateway
  namespace: ${namespace}
binaryData:
  nginx.conf: ${nginx_config_b64}
%{ if enable_fastconnect ~}
---
apiVersion: v1
kind: Secret
metadata:
  name: private-ingest-tls
  namespace: ${namespace}
type: kubernetes.io/tls
data:
  tls.crt: ${private_ingest_cert_b64}
  tls.key: ${private_ingest_key_b64}
%{ endif ~}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: keycloak-database-bootstrap-${keycloak_bootstrap_id}
  namespace: ${namespace}
  labels:
    app.kubernetes.io/name: keycloak-database-bootstrap
spec:
  activeDeadlineSeconds: 900
  backoffLimit: 6
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: keycloak-database-bootstrap
    spec:
      restartPolicy: OnFailure
      containers:
        - name: psql
          image: ${postgres_client_image}
          imagePullPolicy: IfNotPresent
          env:
            - name: PGHOST
              value: "${postgres_host}"
            - name: PGPORT
              value: "5432"
            - name: PGDATABASE
              value: postgres
            - name: PGUSER
              valueFrom:
                secretKeyRef:
                  name: orthanc-runtime
                  key: postgres-username
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: orthanc-runtime
                  key: postgres-password
            - name: KEYCLOAK_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-runtime
                  key: database-password
          command: ["/bin/sh", "-ec"]
          args:
            - |
              until pg_isready -h "$PGHOST" -p "$PGPORT" -U "$PGUSER"; do
                sleep 10
              done
              psql --set=ON_ERROR_STOP=1 --set=keycloak_password="$KEYCLOAK_PASSWORD" <<'SQL'
              SELECT format('CREATE ROLE keycloak LOGIN PASSWORD %L', :'keycloak_password')
              WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'keycloak') \gexec
              SELECT format('ALTER ROLE keycloak LOGIN PASSWORD %L', :'keycloak_password') \gexec
              CREATE SCHEMA IF NOT EXISTS keycloak;
              GRANT CONNECT ON DATABASE postgres TO keycloak;
              GRANT USAGE, CREATE ON SCHEMA keycloak TO keycloak;
              SQL
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 250m
              memory: 256Mi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: keycloak
  namespace: ${namespace}
  labels:
    app.kubernetes.io/name: keycloak
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: keycloak
  template:
    metadata:
      labels:
        app.kubernetes.io/name: keycloak
      annotations:
        oci-dicom.oracle.com/config-sha256: "${keycloak_config_hash}"
    spec:
      initContainers:
        - name: wait-for-database-bootstrap
          image: ${postgres_client_image}
          imagePullPolicy: IfNotPresent
          env:
            - name: PGHOST
              value: "${postgres_host}"
            - name: PGPORT
              value: "5432"
            - name: PGDATABASE
              value: postgres
            - name: PGUSER
              value: keycloak
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-runtime
                  key: database-password
          command: ["/bin/sh", "-ec"]
          args:
            - |
              until psql -tAc \
                "SELECT 1 FROM information_schema.schemata WHERE schema_name = 'keycloak'" \
                | grep -qx 1; do
                sleep 10
              done
      containers:
        - name: keycloak
          image: ${keycloak_image}
          imagePullPolicy: IfNotPresent
          args: ["start", "--import-realm"]
          env:
            - name: KC_DB
              value: postgres
            - name: KC_DB_URL
              value: "jdbc:postgresql://${postgres_host}:5432/postgres"
            - name: KC_DB_SCHEMA
              value: keycloak
            - name: KC_DB_USERNAME
              value: keycloak
            - name: KC_DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-runtime
                  key: database-password
            - name: KC_BOOTSTRAP_ADMIN_USERNAME
              valueFrom:
                secretKeyRef:
                  name: keycloak-runtime
                  key: bootstrap-admin-username
            - name: KC_BOOTSTRAP_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-runtime
                  key: bootstrap-admin-password
            - name: KC_HTTP_ENABLED
              value: "true"
            - name: KC_HTTP_RELATIVE_PATH
              value: /keycloak
            - name: KC_HTTP_MANAGEMENT_RELATIVE_PATH
              value: /
            - name: KC_HOSTNAME
              value: "${public_base_url}/keycloak"
            - name: KC_HOSTNAME_BACKCHANNEL_DYNAMIC
              value: "true"
            - name: KC_PROXY_HEADERS
              value: xforwarded
            - name: KC_PROXY_TRUSTED_ADDRESSES
              value: "10.0.0.0/8"
            - name: KC_HEALTH_ENABLED
              value: "true"
            - name: KC_METRICS_ENABLED
              value: "true"
          ports:
            - name: http
              containerPort: 8080
            - name: management
              containerPort: 9000
          readinessProbe:
            httpGet:
              path: /health/ready
              port: management
            initialDelaySeconds: 20
            periodSeconds: 10
            failureThreshold: 18
          livenessProbe:
            httpGet:
              path: /health/live
              port: management
            initialDelaySeconds: 60
            periodSeconds: 20
          resources:
            requests:
              cpu: 500m
              memory: 1Gi
            limits:
              cpu: "2"
              memory: 2Gi
          volumeMounts:
            - name: realm
              mountPath: /opt/keycloak/data/import
              readOnly: true
      volumes:
        - name: realm
          secret:
            secretName: keycloak-realm
---
apiVersion: v1
kind: Service
metadata:
  name: keycloak
  namespace: ${namespace}
spec:
  selector:
    app.kubernetes.io/name: keycloak
  ports:
    - name: http
      port: 8080
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: orthanc-auth-service
  namespace: ${namespace}
  labels:
    app.kubernetes.io/name: orthanc-auth-service
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: orthanc-auth-service
  template:
    metadata:
      labels:
        app.kubernetes.io/name: orthanc-auth-service
      annotations:
        oci-dicom.oracle.com/config-sha256: "${auth_service_config_hash}"
    spec:
      initContainers:
        - name: wait-for-keycloak
          image: ${nginx_image}
          imagePullPolicy: IfNotPresent
          command: ["/bin/sh", "-ec"]
          args:
            - |
              until wget -qO /dev/null \
                http://keycloak:8080/keycloak/realms/orthanc/; do
                sleep 5
              done
      containers:
        - name: orthanc-auth-service
          image: ${orthanc_auth_service_image}
          imagePullPolicy: IfNotPresent
          env:
            - name: ENABLE_KEYCLOAK
              value: "true"
            - name: KEYCLOAK_URI
              value: "http://keycloak:8080/keycloak/realms/orthanc/"
            - name: PERMISSIONS_FILE_PATH
              value: /etc/orthanc-auth/permissions.json
            - name: PUBLIC_ORTHANC_ROOT
              value: "${public_base_url}/orthanc/"
            - name: PUBLIC_LANDING_ROOT
              value: "${public_base_url}/orthanc/ui/app/token-landing.html"
            - name: USERS
              valueFrom:
                secretKeyRef:
                  name: orthanc-runtime
                  key: auth-users.json
            - name: SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: orthanc-runtime
                  key: auth-secret
          ports:
            - name: http
              containerPort: 8000
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 20
            periodSeconds: 20
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          volumeMounts:
            - name: permissions
              mountPath: /etc/orthanc-auth
              readOnly: true
      volumes:
        - name: permissions
          configMap:
            name: orthanc-authorization
---
apiVersion: v1
kind: Service
metadata:
  name: orthanc-auth-service
  namespace: ${namespace}
spec:
  selector:
    app.kubernetes.io/name: orthanc-auth-service
  ports:
    - name: http
      port: 8000
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: orthanc
  namespace: ${namespace}
  labels:
    app.kubernetes.io/name: orthanc
spec:
  replicas: ${orthanc_replicas}
  selector:
    matchLabels:
      app.kubernetes.io/name: orthanc
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 1
      maxSurge: 1
  template:
    metadata:
      labels:
        app.kubernetes.io/name: orthanc
      annotations:
        oci-dicom.oracle.com/config-sha256: "${orthanc_config_hash}"
    spec:
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: orthanc
      containers:
        - name: orthanc
          image: ${orthanc_image}
          imagePullPolicy: IfNotPresent
          env:
            - name: ORTHANC_JSON
              valueFrom:
                secretKeyRef:
                  name: orthanc-runtime
                  key: orthanc.json
            - name: DICOM_WEB_PLUGIN_ENABLED
              value: "true"
            - name: STONE_WEB_VIEWER_PLUGIN_ENABLED
              value: "true"
            - name: AUTHORIZATION_PLUGIN_ENABLED
              value: "true"
            - name: AWS_S3_STORAGE_PLUGIN_ENABLED
              value: "true"
            - name: POSTGRESQL_PLUGIN_ENABLED
              value: "true"
          ports:
            - name: http
              containerPort: 8042
          readinessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 15
            periodSeconds: 10
            failureThreshold: 18
          livenessProbe:
            tcpSocket:
              port: http
            initialDelaySeconds: 60
            periodSeconds: 20
          resources:
            requests:
              cpu: 500m
              memory: 1Gi
            limits:
              cpu: "2"
              memory: 4Gi
---
apiVersion: v1
kind: Service
metadata:
  name: orthanc
  namespace: ${namespace}
spec:
  selector:
    app.kubernetes.io/name: orthanc
  ports:
    - name: http
      port: 8042
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dicom-gateway
  namespace: ${namespace}
  labels:
    app.kubernetes.io/name: dicom-gateway
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: dicom-gateway
  template:
    metadata:
      labels:
        app.kubernetes.io/name: dicom-gateway
      annotations:
        oci-dicom.oracle.com/config-sha256: "${nginx_config_hash}"
    spec:
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: dicom-gateway
      containers:
        - name: nginx
          image: ${nginx_image}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 101
            runAsGroup: 101
            capabilities:
              drop: ["ALL"]
          ports:
            - name: http
              containerPort: 8080
%{ if enable_fastconnect ~}
            - name: https
              containerPort: 8443
%{ endif ~}
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 15
            periodSeconds: 20
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          volumeMounts:
            - name: config
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
%{ if enable_fastconnect ~}
            - name: tls
              mountPath: /etc/nginx/tls
              readOnly: true
%{ endif ~}
      volumes:
        - name: config
          configMap:
            name: dicom-gateway
%{ if enable_fastconnect ~}
        - name: tls
          secret:
            secretName: private-ingest-tls
%{ endif ~}
---
apiVersion: v1
kind: Service
metadata:
  name: dicom-gateway
  namespace: ${namespace}
  annotations:
    oci.oraclecloud.com/load-balancer-type: "nlb"
    oci-network-load-balancer.oraclecloud.com/internal: "true"
    oci-network-load-balancer.oraclecloud.com/subnet: "${nlb_subnet_id}"
    oci.oraclecloud.com/reserved-private-ips: "${nlb_private_ip}"
    oci-network-load-balancer.oraclecloud.com/oci-network-security-groups: "${nlb_nsg_id}"
    oci.oraclecloud.com/security-rule-management-mode: "None"
    oci.oraclecloud.com/compartment-id: "${compartment_id}"
    oci-network-load-balancer.oraclecloud.com/health-check-retries: "5"
    oci-network-load-balancer.oraclecloud.com/health-check-interval: "10000"
    oci-network-load-balancer.oraclecloud.com/health-check-timeout: "4000"
spec:
  type: LoadBalancer
  externalTrafficPolicy: Cluster
  selector:
    app.kubernetes.io/name: dicom-gateway
  ports:
    - name: http
      protocol: TCP
      port: 8080
      targetPort: http
      nodePort: 30080
%{ if enable_fastconnect ~}
    - name: https
      protocol: TCP
      port: 8443
      targetPort: https
      nodePort: 30443
%{ endif ~}
